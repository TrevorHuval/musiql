# Copy to .env for local development. The API connection string in
# src/MusiQL.Api/appsettings.json expects these same credentials.
POSTGRES_USER=musiql
POSTGRES_PASSWORD=musiql
POSTGRES_DB=musiql
POSTGRES_PORT=5442

# Only needed for the production-ish stack (docker compose --profile prod).
# Generate a long random signing key; the dev appsettings key is not loaded
# when the API runs in the Production environment.
JWT_SIGNING_KEY=change-me-to-a-long-random-value-at-least-32-bytes
WEB_PORT=8088

# Read-only role for MQL execution (src/MusiQL.Data/Sql/query_role.sql). The API
# refuses to start in Production without it unless QUERY_ALLOW_OWNER_CONNECTION
# is true, which is only acceptable for a local stack.
QUERY_CONNECTION=
QUERY_ALLOW_OWNER_CONNECTION=true

# Reverse-proxy hops in front of the API whose X-Forwarded-For is trusted.
# 1 = nginx only (this compose); 2 = an edge proxy such as Caddy, then nginx.
PROXY_TRUSTED_HOPS=1

# Stop accepting registrations once this many accounts exist (0 = unlimited).
MAX_USERS=0

# Container memory ceilings. Tune after measuring on the target host.
POSTGRES_MEMORY_LIMIT=768m
API_MEMORY_LIMIT=512m
WEB_MEMORY_LIMIT=64m

# Optional Spotify integration for the prod profile (leave blank to disable).
SPOTIFY_CLIENT_ID=
SPOTIFY_TOKEN_ENCRYPTION_KEY=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8088/settings/spotify/callback
