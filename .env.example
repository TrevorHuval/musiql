# Copy to .env for local development. The API connection string in
# src/MusiQL.Api/appsettings.json expects these same credentials.
POSTGRES_USER=musiql
POSTGRES_PASSWORD=musiql
POSTGRES_DB=musiql
POSTGRES_PORT=5442

# Only needed for the production-ish stack (docker compose --profile prod).
# Generate a long random signing key; the dev appsettings key is not loaded
# when the API runs in the Production environment.
JWT_SIGNING_KEY=change-me-to-a-long-random-value-at-least-32-bytes
WEB_PORT=8088

# Optional Spotify integration for the prod profile (leave blank to disable).
SPOTIFY_CLIENT_ID=
SPOTIFY_TOKEN_ENCRYPTION_KEY=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8088/settings/spotify/callback
